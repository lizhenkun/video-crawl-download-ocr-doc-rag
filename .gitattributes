# 默认：让 Git 自动识别文本文件，仓库内统一规范化为 LF
* text=auto
.gitattributes text eol=lf
.gitignore     text eol=lf

# 代码与文本文件：仓库内统一 LF
*.py    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.python-version text eol=lf

# Windows 原生脚本：检出时使用 CRLF（批处理对 LF 兼容性差）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件：不做任何行尾转换
*.xlsx  binary
*.xls   binary
*.lnk   binary
*.mp4   binary
*.avi   binary
*.mkv   binary
*.mov   binary
*.mp3   binary
*.wav   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.zip   binary
*.7z    binary
*.tar   binary
*.gz    binary
